Description: Make Debian package builds reproducible and flag-complete.
 Propagate CPPFLAGS and LDFLAGS to dictionary build helpers, make generated
 dictionary identifiers honor SOURCE_DATE_EPOCH, and provide the directory
 substitutions required by the non-traditional Debian filesystem layout.
Origin: vendor
Forwarded: not-needed
Last-Update: 2026-07-14

diff --git a/Wnn/etc/bdic.c b/Wnn/etc/bdic.c
index 7353bee..79af981 100644
--- a/Wnn/etc/bdic.c
+++ b/Wnn/etc/bdic.c
@@ -49,6 +49,7 @@
 #endif /* defined(JSERVER) || defined(JS) */
 
 #include <sys/types.h>
+#include <stdlib.h>
 #include <stdio.h>
 #if STDC_HEADERS
 #  include <string.h>
@@ -544,6 +545,7 @@ create_file_header (FILE* ofpter, int file_type, char* file_passwd)
 {
   struct stat buf;
   char hostname[WNN_HOSTLEN];
+  char *source_date_epoch;
   struct wnn_file_head fh;
 
   if (fstat (fileno (ofpter), &buf) == -1)
@@ -553,16 +555,27 @@ create_file_header (FILE* ofpter, int file_type, char* file_passwd)
   gethostname (hostname, WNN_HOSTLEN);
   hostname[WNN_HOSTLEN - 1] = '\0';
 
-  fh.file_uniq.time = (int) buf.st_ctime;
-  fh.file_uniq.dev = (int) buf.st_dev;
-  fh.file_uniq.inode = (int) buf.st_ino;
+  source_date_epoch = getenv ("SOURCE_DATE_EPOCH");
+  if (source_date_epoch)
+    {
+      fh.file_uniq.time = (int) strtol (source_date_epoch, NULL, 10);
+      fh.file_uniq.dev = 0;
+      fh.file_uniq.inode = 0;
+      hostname[0] = '\0';
+    }
+  else
+    {
+      fh.file_uniq.time = (int) buf.st_ctime;
+      fh.file_uniq.dev = (int) buf.st_dev;
+      fh.file_uniq.inode = (int) buf.st_ino;
+    }
   bzero (fh.file_uniq.createhost, WNN_HOSTLEN);
   strcpy (fh.file_uniq.createhost, hostname);
 
   /* file_uniq_org */
-  fh.file_uniq_org.time = (int) buf.st_ctime;
-  fh.file_uniq_org.dev = (int) buf.st_dev;
-  fh.file_uniq_org.inode = (int) buf.st_ino;
+  fh.file_uniq_org.time = fh.file_uniq.time;
+  fh.file_uniq_org.dev = fh.file_uniq.dev;
+  fh.file_uniq_org.inode = fh.file_uniq.inode;
   bzero (fh.file_uniq_org.createhost, WNN_HOSTLEN);
   strcpy (fh.file_uniq_org.createhost, hostname);
 
diff --git a/Wnn/etc/pwd.c b/Wnn/etc/pwd.c
index 1f5614f..60ea4d3 100644
--- a/Wnn/etc/pwd.c
+++ b/Wnn/etc/pwd.c
@@ -32,6 +32,7 @@
 /*
   eval(crypt(PWD, "HA")) routine.
 */
+#include <stdlib.h>
 #ifdef HAVE_CONFIG_H
 #  include <config.h>
 #endif
@@ -78,7 +79,10 @@ new_pwd (char* src, char* encd)
       bzero (encd, WNN_PASSWD_LEN);
       return;
     }
-  x = time ((time_t *) NULL);
+  if (getenv ("SOURCE_DATE_EPOCH"))
+    x = (int) strtol (getenv ("SOURCE_DATE_EPOCH"), NULL, 10);
+  else
+    x = time ((time_t *) NULL);
   xx[0] = x & 0x3f;
   xx[1] = (x & 0x3f00) >> 8;
   xx[2] = '\0';                 /* for MD5 (that requires terminator) */
diff --git a/Wnn/pubdicplus/Makefile.in b/Wnn/pubdicplus/Makefile.in
index 7d4e068..8062df3 100644
--- a/Wnn/pubdicplus/Makefile.in
+++ b/Wnn/pubdicplus/Makefile.in
@@ -326,31 +326,31 @@ fzk.master-.c: fzk.master
 	$(LN) $? $@
 
 std.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) fzk.master-.c > $@
 
 full.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) -DKANSAI fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) -DKANSAI fzk.master-.c > $@
 
 kougo.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) -DKOUGO fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) -DKOUGO fzk.master-.c > $@
 
 # additional rule from PubdicPlus/Makefile.in : by aono
 pod.o: $(PUBDICPLUSSRC)/pod.c
 	$(CC) $(CFLAGS) -c $?
 
 pod: pod.o
-	$(CC) $(CFLAGS) -o $@ pod.o
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ pod.o
 
 $(WNNDICS): pod $(PUBDICPLUSSRC)/pubdic.p
-	./pod $(PUBDICPLUSSRC)/pubdic.p -w -1 -k `basename $@ .u` > $@
+	LC_ALL=C ./pod $(PUBDICPLUSSRC)/pubdic.p -w -1 -k `basename $@ .u` > $@
 
 .SUFFIXES: .hd .u .dic .more .fsrc .fzk
 
 .u.dic:
-	cat $*.hd $< | $(ATOD) -p $(VERSION) -P $(VERSION) -h $(HINSI) $@
+	LC_ALL=C cat $*.hd $< | LC_ALL=C $(ATOD) -p $(VERSION) -P $(VERSION) -h $(HINSI) $@
 
 .hd.more:
-	$(ATOD) -h $(HINSI) $@ < $<
+	LC_ALL=C $(ATOD) -h $(HINSI) $@ < $<
 
 .fsrc.fzk:
 	LC_ALL=C egrep -v '^(# |#line |#pragma |$$)' $< | $(ATOF) -h $(HINSI) $@
