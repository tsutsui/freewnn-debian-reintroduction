Description: Make dictionary generation locale-stable and pass build flags.
 Run dictionary text filtering in the C locale. Pass CPPFLAGS to dictionary
 preprocessing and LDFLAGS when linking its build helper, as required by blhc.
 Source commits: 1195a7660cd0ff31dbe0daec09210338126fa1bf
Origin: upstream
Bug-Debian: https://bugs.debian.org/797242
Forwarded: yes
Last-Update: 2026-07-12

diff --git a/Wnn/pubdicplus/Makefile.in b/Wnn/pubdicplus/Makefile.in
index 001a22c..7d4e068 100644
--- a/Wnn/pubdicplus/Makefile.in
+++ b/Wnn/pubdicplus/Makefile.in
@@ -329 +329 @@ std.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) fzk.master-.c > $@
@@ -332 +332 @@ full.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) -DKANSAI fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) -DKANSAI fzk.master-.c > $@
@@ -335 +335 @@ kougo.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) -DKOUGO fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) -DKOUGO fzk.master-.c > $@
@@ -342 +342 @@ pod: pod.o
-	$(CC) $(CFLAGS) -o $@ pod.o
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ pod.o
@@ -353,7 +353,7 @@ $(WNNDICS): pod $(PUBDICPLUSSRC)/pubdic.p
 	$(ATOD) -h $(HINSI) $@ < $<
 
 .fsrc.fzk:
-	egrep -v '^(# |#line |#pragma |$$)' $< | $(ATOF) -h $(HINSI) $@
+	LC_ALL=C egrep -v '^(# |#line |#pragma |$$)' $< | $(ATOF) -h $(HINSI) $@
 
 $(DIC): $(HINSI)
 
diff --git a/cWnn/cdic/Makefile.in b/cWnn/cdic/Makefile.in
