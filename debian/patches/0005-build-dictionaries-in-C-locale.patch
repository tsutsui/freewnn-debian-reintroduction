Description: Make dictionary generation locale-stable and pass build flags.
 Run dictionary text filtering in the C locale. Honor SOURCE_DATE_EPOCH in
 generated dictionary identifiers. Pass CPPFLAGS to dictionary preprocessing
 and LDFLAGS when linking its build helper, as required by blhc.
 Source commits: 1195a7660cd0ff31dbe0daec09210338126fa1bf
Origin: upstream
Bug-Debian: https://bugs.debian.org/797242
Forwarded: yes
Last-Update: 2026-07-12

diff --git a/Wnn/etc/bdic.c b/Wnn/etc/bdic.c
--- a/Wnn/etc/bdic.c
+++ b/Wnn/etc/bdic.c
@@ -51,0 +52 @@
+#include <stdlib.h>
@@ -546,0 +548 @@ create_file_header (FILE* ofpter, int file_type, char* file_passwd)
+  char *source_date_epoch;
@@ -554,3 +557,14 @@ create_file_header (FILE* ofpter, int file_type, char* file_passwd)
-  fh.file_uniq.time = (int) buf.st_ctime;
-  fh.file_uniq.dev = (int) buf.st_dev;
-  fh.file_uniq.inode = (int) buf.st_ino;
+  source_date_epoch = getenv ("SOURCE_DATE_EPOCH");
+  if (source_date_epoch)
+    {
+      fh.file_uniq.time = (int) strtol (source_date_epoch, NULL, 10);
+      fh.file_uniq.dev = 0;
+      fh.file_uniq.inode = 0;
+      hostname[0] = '\0';
+    }
+  else
+    {
+      fh.file_uniq.time = (int) buf.st_ctime;
+      fh.file_uniq.dev = (int) buf.st_dev;
+      fh.file_uniq.inode = (int) buf.st_ino;
+    }
@@ -563,3 +578,3 @@ create_file_header (FILE* ofpter, int file_type, char* file_passwd)
-  fh.file_uniq_org.time = (int) buf.st_ctime;
-  fh.file_uniq_org.dev = (int) buf.st_dev;
-  fh.file_uniq_org.inode = (int) buf.st_ino;
+  fh.file_uniq_org.time = fh.file_uniq.time;
+  fh.file_uniq_org.dev = fh.file_uniq.dev;
+  fh.file_uniq_org.inode = fh.file_uniq.inode;

diff --git a/Wnn/pubdicplus/Makefile.in b/Wnn/pubdicplus/Makefile.in
--- a/Wnn/pubdicplus/Makefile.in
+++ b/Wnn/pubdicplus/Makefile.in
@@ -329 +329 @@ std.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) fzk.master-.c > $@
@@ -332 +332 @@ full.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) -DKANSAI fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) -DKANSAI fzk.master-.c > $@
@@ -335 +335 @@ kougo.fsrc: fzk.master-.c $(FZK_SRC)
-	$(FZK_PP) -DKOUGO fzk.master-.c > $@
+	$(FZK_PP) $(CPPFLAGS) -DKOUGO fzk.master-.c > $@
@@ -342 +342 @@ pod: pod.o
-	$(CC) $(CFLAGS) -o $@ pod.o
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ pod.o
@@ -345 +345 @@ $(WNNDICS): pod $(PUBDICPLUSSRC)/pubdic.p
-	./pod $(PUBDICPLUSSRC)/pubdic.p -w -1 -k `basename $@ .u` > $@
+	LC_ALL=C ./pod $(PUBDICPLUSSRC)/pubdic.p -w -1 -k `basename $@ .u` > $@
@@ -350 +350 @@ .u.dic:
-	cat $*.hd $< | $(ATOD) -p $(VERSION) -P $(VERSION) -h $(HINSI) $@
+	LC_ALL=C cat $*.hd $< | LC_ALL=C $(ATOD) -p $(VERSION) -P $(VERSION) -h $(HINSI) $@
@@ -353 +353 @@ .hd.more:
-	$(ATOD) -h $(HINSI) $@ < $<
+	LC_ALL=C $(ATOD) -h $(HINSI) $@ < $<
@@ -353,7 +353,7 @@ $(WNNDICS): pod $(PUBDICPLUSSRC)/pubdic.p
 	$(ATOD) -h $(HINSI) $@ < $<
 
 .fsrc.fzk:
-	egrep -v '^(# |#line |#pragma |$$)' $< | $(ATOF) -h $(HINSI) $@
+	LC_ALL=C egrep -v '^(# |#line |#pragma |$$)' $< | $(ATOF) -h $(HINSI) $@
 
 $(DIC): $(HINSI)

diff --git a/Wnn/etc/pwd.c b/Wnn/etc/pwd.c
--- a/Wnn/etc/pwd.c
+++ b/Wnn/etc/pwd.c
@@ -34,0 +35 @@
+#include <stdlib.h>
@@ -83 +84,4 @@ new_pwd (char* src, char* encd)
-  x = time ((time_t *) NULL);
+  if (getenv ("SOURCE_DATE_EPOCH"))
+    x = (int) strtol (getenv ("SOURCE_DATE_EPOCH"), NULL, 10);
+  else
+    x = time ((time_t *) NULL);

diff --git a/cWnn/cdic/Makefile.in b/cWnn/cdic/Makefile.in
